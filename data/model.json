acturing_electricity_mix_EU + 0.0777*Manufacturing_electricity_mix_FR + 0.00628*Manufacturing_electricity_mix_Nuclear + 0.0828*Manufacturing_electricity_mix_PV + 0.471*Manufacturing_electricity_mix_US + 0.708*Manufacturing_electricity_mix_World) + 0.0552*Silicon_production_heat_intensity + 11.9*Manufacturing_electricity_mix_CN + 12.4*Manufacturing_electricity_mix_CO2content*(1.09*Electricity_mix_CO2_content + 0.00627) + 13.2*Manufacturing_electricity_mix_Coal + 4.21*Manufacturing_electricity_mix_EU + 0.966*Manufacturing_electricity_mix_FR + 0.078*Manufacturing_electricity_mix_Nuclear + 1.03*Manufacturing_electricity_mix_PV + 5.85*Manufacturing_electricity_mix_US + 8.8*Manufacturing_electricity_mix_World + 7.58)/(0.15*Diamond_wiring_cutting - Kerf_loss + 1) + 4.49*Manufacturing_electricity_mix_CN + 4.71*Manufacturing_electricity_mix_CO2content*(1.09*Electricity_mix_CO2_content + 0.00627) + 5.02*Manufacturing_electricity_mix_Coal + 1.59*Manufacturing_electricity_mix_EU + 0.366*Manufacturing_electricity_mix_FR + 0.0296*Manufacturing_electricity_mix_Nuclear + 0.39*Manufacturing_electricity_mix_PV + 2.22*Manufacturing_electricity_mix_US + 3.33*Manufacturing_electricity_mix_World + 7.0*(1.0 - SiC_recycled_share)*(2.03 - 2.03*Diamond_wiring_cutting) + 0.988*(8 - 8*Manufacturing_efficiency_gains)*(0.953*Manufacturing_electricity_mix_CN + Manufacturing_electricity_mix_CO2content*(1.09*Electricity_mix_CO2_content + 0.00627) + 1.07*Manufacturing_electricity_mix_Coal + 0.338*Manufacturing_electricity_mix_EU + 0.0777*Manufacturing_electricity_mix_FR + 0.00628*Manufacturing_electricity_mix_Nuclear + 0.0828*Manufacturing_electricity_mix_PV + 0.471*Manufacturing_electricity_mix_US + 0.708*Manufacturing_electricity_mix_World) + 0.932*(30.2 - 30.2*Manufacturing_efficiency_gains)*(0.953*Manufacturing_electricity_mix_CN + Manufacturing_electricity_mix_CO2content*(1.09*Electricity_mix_CO2_content + 0.00627) + 1.07*Manufacturing_electricity_mix_Coal + 0.338*Manufacturing_electricity_mix_